{
	"name": "overseer-hub",
	"version": "0.0.1",
	"private": true,
	"description": "A small remote MCP server on Cloudflare Workers that stores shared facts in D1 for Claude projects.",
	"type": "module",
	"scripts": {
		"dev": "wrangler dev",
		"deploy": "wrangler deploy",
		"types": "wrangler types",
		"type-check": "tsc --noEmit",
		"test": "vitest run",
		"db:migrate:local": "wrangler d1 migrations apply overseer-hub --local",
		"db:migrate:remote": "wrangler d1 migrations apply overseer-hub --remote",
		"seed:local": "node scripts/seed.ts --local",
		"seed:remote": "node scripts/seed.ts --remote"
	},
	"dependencies": {
		"@cloudflare/workers-oauth-provider": "1.3.0",
		"@modelcontextprotocol/server": "2.4.0",
		"agents": "0.34.0",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@cloudflare/vitest-plugin": "1.9.1",
		"typescript": "6.0.3",
		"vitest": "4.1.12",
		"wrangler": "4.166.0"
	}
}
